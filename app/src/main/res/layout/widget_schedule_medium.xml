<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <!-- 小部件背景图：设置里选过才显示（id 四个布局统一，代码里同一个写法） -->
    <ImageView android:id="@+id/widget_card" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_bg" />
    <ImageView android:id="@+id/widget_bg_image" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:visibility="gone" />
    <LinearLayout android:id="@+id/widget2_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingLeft="9dp" android:paddingTop="8dp" android:paddingRight="9dp" android:paddingBottom="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/widget2_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:singleLine="true" android:text="第 1 周" android:textColor="#FF303F9F" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget2_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true" android:text="周一 3/9" android:textColor="#99000000" android:textSize="11sp" />
        </LinearLayout>
        <TextView android:id="@+id/widget2_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="今天没课 🎉" android:textColor="#99000000" android:textSize="11sp" android:visibility="gone" />
        <FrameLayout android:id="@+id/widget2_row_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp">
            <ImageView android:id="@+id/widget2_cell_1" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingLeft="4dp" android:paddingTop="2dp" android:paddingRight="4dp" android:paddingBottom="2dp" android:id="@+id/widget2_rowin_1">
                <!-- 左边：上课时间（上一行起始、下一行结束，两行） -->
                <TextView android:id="@+id/widget2_time_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="34dp" android:maxLines="2" android:text="8:00\n8:40" android:textColor="#FF5F6368" android:textSize="10sp" />
                <!-- 蓝色竖线：左边时间、右边课程，就靠它分开 -->
                <TextView android:id="@+id/widget2_line_1" android:maxLines="1" android:layout_width="2dp" android:layout_height="match_parent" android:minHeight="28dp" android:layout_marginLeft="8dp" android:layout_marginRight="8dp" android:background="#FF4A6CF7" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/widget2_text_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:singleLine="true" android:text="高等数学" android:textColor="#FF1F1F1F" android:textSize="12sp" android:textStyle="bold" />
                    <TextView android:id="@+id/widget2_info_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:singleLine="true" android:text="第1-2节｜4教204｜张老师" android:textColor="#FF7A7A7A" android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
        <FrameLayout android:id="@+id/widget2_row_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp">
            <ImageView android:id="@+id/widget2_cell_2" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingLeft="4dp" android:paddingTop="2dp" android:paddingRight="4dp" android:paddingBottom="2dp" android:id="@+id/widget2_rowin_2">
                <!-- 左边：上课时间（上一行起始、下一行结束，两行） -->
                <TextView android:id="@+id/widget2_time_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="34dp" android:maxLines="2" android:text="8:00\n8:40" android:textColor="#FF5F6368" android:textSize="10sp" />
                <!-- 蓝色竖线：左边时间、右边课程，就靠它分开 -->
                <TextView android:id="@+id/widget2_line_2" android:maxLines="1" android:layout_width="2dp" android:layout_height="match_parent" android:minHeight="28dp" android:layout_marginLeft="8dp" android:layout_marginRight="8dp" android:background="#FF4A6CF7" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/widget2_text_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:singleLine="true" android:text="高等数学" android:textColor="#FF1F1F1F" android:textSize="12sp" android:textStyle="bold" />
                    <TextView android:id="@+id/widget2_info_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:singleLine="true" android:text="第1-2节｜4教204｜张老师" android:textColor="#FF7A7A7A" android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
        <FrameLayout android:id="@+id/widget2_row_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp">
            <ImageView android:id="@+id/widget2_cell_3" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingLeft="4dp" android:paddingTop="2dp" android:paddingRight="4dp" android:paddingBottom="2dp" android:id="@+id/widget2_rowin_3">
                <!-- 左边：上课时间（上一行起始、下一行结束，两行） -->
                <TextView android:id="@+id/widget2_time_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="34dp" android:maxLines="2" android:text="8:00\n8:40" android:textColor="#FF5F6368" android:textSize="10sp" />
                <!-- 蓝色竖线：左边时间、右边课程，就靠它分开 -->
                <TextView android:id="@+id/widget2_line_3" android:maxLines="1" android:layout_width="2dp" android:layout_height="match_parent" android:minHeight="28dp" android:layout_marginLeft="8dp" android:layout_marginRight="8dp" android:background="#FF4A6CF7" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/widget2_text_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:singleLine="true" android:text="高等数学" android:textColor="#FF1F1F1F" android:textSize="12sp" android:textStyle="bold" />
                    <TextView android:id="@+id/widget2_info_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:singleLine="true" android:text="第1-2节｜4教204｜张老师" android:textColor="#FF7A7A7A" android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
        <TextView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <TextView android:id="@+id/widget2_footer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="点一下打开课表" android:textColor="#80000000" android:textSize="10sp" />
    </LinearLayout>
</FrameLayout>
<?xml version="1.0" encoding="utf-8"?>
<!--
  1×1 小组件：只有一格，只放「最近一节课」——节次 + 课程名，没课就写今天没课。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 小部件背景图：设置里选过才显示（id 四个布局统一，代码里同一个写法） -->
    <ImageView
        android:id="@+id/widget_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg" />
    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget0_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingLeft="4dp"
        android:paddingTop="4dp"
        android:paddingRight="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/widget0_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:singleLine="true"
            android:text="今天"
            android:textColor="#99000000"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/widget0_main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:gravity="center"
            android:singleLine="true"
            android:text="1-2节"
            android:textColor="#FF1F1F1F"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget0_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:text="高等数学"
            android:textColor="#99000000"
            android:textSize="10sp" />
    </LinearLayout>

</FrameLayout>

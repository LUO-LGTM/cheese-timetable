<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <!-- 小部件背景图：设置里选过才显示（id 四个布局统一，代码里同一个写法） -->
    <ImageView android:id="@+id/widget_card" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_bg" />
    <ImageView android:id="@+id/widget_bg_image" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:visibility="gone" />
    <LinearLayout android:id="@+id/widget1_root" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:paddingLeft="10dp" android:paddingTop="4dp" android:paddingRight="10dp" android:paddingBottom="4dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/widget1_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:singleLine="true" android:text="第 1 周" android:textColor="#FF303F9F" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget1_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true" android:text="周一 3/9" android:textColor="#99000000" android:textSize="11sp" />
        </LinearLayout>
        <!-- 有课：左时间｜蓝线｜右边课名 + 节数｜教室｜教师 -->
        <FrameLayout android:id="@+id/widget1_course_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp">
            <ImageView android:id="@+id/widget1_cell" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/widget1_rowin">
                <TextView android:id="@+id/widget1_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="34dp" android:maxLines="2" android:text="8:00\n8:40" android:textColor="#FF5F6368" android:textSize="10sp" />
                <!-- 蓝色竖线：左边时间、右边课程，就靠它分开 -->
                <TextView android:id="@+id/widget1_line" android:maxLines="1" android:layout_width="2dp" android:layout_height="match_parent" android:minHeight="28dp" android:layout_marginLeft="8dp" android:layout_marginRight="8dp" android:background="#FF4A6CF7" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/widget1_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:singleLine="true" android:text="高等数学" android:textColor="#FF1F1F1F" android:textSize="13sp" android:textStyle="bold" />
                    <TextView android:id="@+id/widget1_info" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:singleLine="true" android:text="第1-2节｜4教204｜张老师" android:textColor="#FF7A7A7A" android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
        <!-- 没课 / 没数据：显示这一行，课程那块隐藏 -->
        <TextView android:id="@+id/widget1_msg" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:ellipsize="end" android:singleLine="true" android:text="今天没课 🎉" android:textColor="#FF1F1F1F" android:textSize="13sp" android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
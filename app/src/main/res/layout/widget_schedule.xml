                    <TextView android:id="@+id/widget_info_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:singleLine="true" android:text="第1-2节｜4教204｜张老师" android:textColor="#FF7A7A7A" android:textSize="10sp" />
                </LinearLayout>

            </LinearLayout>
        </FrameLayout>
        <!-- 撑满剩余高度：让卡片永远占满格子 -->
        <TextView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <TextView android:id="@+id/widget_footer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="点一下打开课表" android:textColor="#80000000" android:textSize="10sp" />
    </LinearLayout>
</FrameLayout>
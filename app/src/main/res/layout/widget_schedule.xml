                <TextView android:id="@+id/widget_line_5" android:maxLines="1" android:layout_width="2dp" android:layout_height="match_parent" android:minHeight="28dp" android:layout_marginLeft="8dp" android:layout_marginRight="8dp" android:background="#FF4A6CF7" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/widget_text_5" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:singleLine="true" android:text="高等数学" android:textColor="#FF1F1F1F" android:textSize="13sp" android:textStyle="bold" />
                    <TextView android:id="@+id/widget_info_5" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:singleLine="true" android:text="第1-2节｜4教204｜张老师" android:textColor="#FF7A7A7A" android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
        <FrameLayout android:id="@+id/widget_row_6" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp">
            <ImageView android:id="@+id/widget_cell_6" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingLeft="6dp" android:paddingTop="3dp" android:paddingRight="6dp" android:paddingBottom="3dp" android:id="@+id/widget_rowin_6">
                <!-- 左边：上课时间（上一行起始、下一行结束，两行） -->
                <TextView android:id="@+id/widget_time_6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="34dp" android:maxLines="2" android:text="8:00\n8:40" android:textColor="#FF5F6368" android:textSize="11sp" />
